# MSCTS 配置（启动时读取一次，运行时不修改 .env —— 蓝图 §5.1）

# 数据库类型：sqlite | postgres
DB_TYPE=sqlite

# SQLite 数据库文件路径（DB_TYPE=sqlite 时生效）
SQLITE_PATH=./data/mscts.db

# PostgreSQL 连接串（DB_TYPE=postgres 时必填）
# DATABASE_URL=postgres://user:password@localhost:5432/mscts

# 迁移文件根目录（默认 ./schema，一般不需要改）
# MIGRATIONS_DIR=./schema

# 本地存储根目录（默认 ./data/uploads）
# UPLOAD_DIR=./data/uploads

# 对外公开 URL 前缀（含静态挂载点）
# PUBLIC_BASE_URL=http://localhost:3000/uploads

# Yggdrasil RSA 私钥路径（不存在时启动自动生成；默认 ./data/keys/yggdrasil.pem）
# RSA_PRIVATE_KEY_PATH=./data/keys/yggdrasil.pem

# Yggdrasil skinDomains（逗号分隔；缺省用 PUBLIC_BASE_URL 的 hostname）
# YGGDRASIL_SKIN_DOMAINS=skin.example.com

# ---- P5 可选依赖（不设置即关闭该能力，核心功能不受影响）----

# Redis 连接串。用于认证端点限流与站点设置缓存。
# 未设置 → 使用进程内存实现（单实例够用；多实例下每个实例各限一份，计数不共享）
# 设置了但连不上 → 记 warning 后同样降级为内存实现，进程照常启动（可用性优先）
# REDIS_URL=redis://127.0.0.1:63799

# 限流总开关：true 时完全不做限流（排障/压测用）
# RATE_LIMIT_DISABLED=true

# 认证端点限流窗口内最大尝试次数（默认 5）
# AUTH_RATE_LIMIT_MAX=5

# 认证端点限流窗口毫秒数（默认 300000 = 5 分钟）
# AUTH_RATE_LIMIT_WINDOW_MS=300000

# 站点公开设置缓存 TTL 毫秒数（默认 30000；写设置会主动失效，无需等 TTL）
# SETTINGS_CACHE_TTL_MS=30000

# 反代层数/可信代理（Express trust proxy）。生产是 OpenResty + 1Panel，
# 不设置时 req.ip 是反代自身地址 → 按 IP 限流的端点（如注册）会把所有用户算成一个桶。
# 仅在确实位于可信反代之后才可开启，否则客户端可伪造 X-Forwarded-For 绕过限流。
# TRUST_PROXY=1

# ---- 仅测试用 ----
# 指向一个【可随意销毁的空临时库】时，smoke test 会额外执行 PostgreSQL 全套迁移测试
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/mscts_smoke_test

# 指向一个【可随意销毁的】Redis 时，缓存测试会额外执行 Redis 实现用例（未设置则 skip）
# TEST_REDIS_URL=redis://127.0.0.1:63799
