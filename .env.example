# MCSTS 配置（启动时读取一次，运行时不修改 .env —— 蓝图 §5.1）

# 数据库类型：sqlite | postgres
DB_TYPE=sqlite

# SQLite 数据库文件路径（DB_TYPE=sqlite 时生效）
SQLITE_PATH=./data/mcsts.db

# PostgreSQL 连接串（DB_TYPE=postgres 时必填）
# DATABASE_URL=postgres://user:password@localhost:5432/mcsts

# 迁移文件根目录（默认 ./schema，一般不需要改）
# MIGRATIONS_DIR=./schema

# 本地存储根目录（默认 ./data/uploads）
# UPLOAD_DIR=./data/uploads

# 对外公开 URL 前缀（含静态挂载点）。注意这是**素材前缀**（纹理等静态资源），
# 不是站点根 —— 站点根是后台设置项 BASE_URL，由管理员在「系统设置 → 邮箱设置」里填，
# 它是邮件里验证/重置链接的权威来源。两者不能合并，理由见 README「地址双口径」。
# PUBLIC_BASE_URL=http://localhost:3000/uploads

# Yggdrasil RSA 私钥路径（不存在时启动自动生成；默认 ./data/keys/yggdrasil.pem）
# RSA_PRIVATE_KEY_PATH=./data/keys/yggdrasil.pem

# Yggdrasil skinDomains（逗号分隔；缺省由**站点根**的 hostname 派生）
# YGGDRASIL_SKIN_DOMAINS=skin.example.com

# ---- P5 邮件（SMTP 本身是后台设置项，这里只有两个环境变量）----

# 站点设置里凭据类键（SMTP_PASS、EXTERNAL_CAPTCHA_SECRET）的加密主密钥，AES-256-GCM，至少 16 字符。
# 未设置 → 这些值按明文落库（功能可用，但数据库备份/只读副本会把它们带出去）。
# 轮换后旧密文无法解密（会明确报「密文解密失败」，不会静默返回空口令）。
# MCSTS_SECRET=please-change-me-32-chars-min

# 允许 SMTP 服务端使用自签证书（内网邮件网关常见）。缺省关闭。
# SMTP_ALLOW_SELF_SIGNED=true

# 密码哈希强度（bcrypt cost）。缺省 10（OWASP 下限），钳制到 10-14：越界不报错，
# 会钳制/回落并打一条警告 —— 装到一半服务起不来比登录慢 200ms 严重得多。
# 注册 / 改密 / 安装向导三条写入路径共用这一个值。
# 调高后**存量账号会在用户下次登录成功时自动重算**（rehash-on-login），不必强制改密码；
# 调低不会降级已有哈希。
# 代价（本机 16 核、bcryptjs 纯 JS 实现实测）：cost 10 → 校验 78ms / 生成 118ms；
# cost 12 → 校验 342ms / 生成 313ms，即登录一次约从 80ms 变 340ms，低配 VPS 更慢。
# BCRYPT_COST=10

# ---- P5 可选依赖（不设置即关闭该能力，核心功能不受影响）----

# Redis 连接串。用于认证端点限流与站点设置缓存。
# 未设置 → 使用进程内存实现（单实例够用；多实例下每个实例各限一份，计数不共享）
# 设置了但连不上 → 记 warning 后同样降级为内存实现，进程照常启动（可用性优先）
# REDIS_URL=redis://127.0.0.1:63799

# 限流总开关：true 时完全不做限流（排障/压测用）
# RATE_LIMIT_DISABLED=true

# 认证端点限流窗口内最大尝试次数（默认 5）
# AUTH_RATE_LIMIT_MAX=5

# 认证端点限流窗口毫秒数（默认 300000 = 5 分钟）
# AUTH_RATE_LIMIT_WINDOW_MS=300000

# Yggdrasil POST /refresh 专用限流（按来源 IP，不是按用户名）。
# 单独一套是因为 refresh 属于启动器的后台定期行为：按用户名计会把挂机中的启动器
# 误判成攻击（症状是「挂机一阵后突然掉线」）。默认比登录宽松得多。
# 共用 RATE_LIMIT_DISABLED 总开关。
# REFRESH_RATE_LIMIT_MAX=30
# REFRESH_RATE_LIMIT_WINDOW_MS=300000

# Yggdrasil POST /api/profiles/minecraft 专用限流（按来源 IP）。
# 这个端点匿名可用（角色名 → UUID，单次最多 10 名），不限流就等于允许无限速遍历全站
# 角色名与 UUID；但阈值必须宽松 —— 真客户端进服时也会打它，共用出口地址（宿舍/机房 NAT）
# 下多人同时进服会落在同一个键上。默认 60 次/分钟。共用 RATE_LIMIT_DISABLED 总开关。
# PROFILE_LOOKUP_RATE_LIMIT_MAX=60
# PROFILE_LOOKUP_RATE_LIMIT_WINDOW_MS=60000

# 验证码出题端点（GET /api/captcha/generate 与 GET /api/captcha/image）共用一套专用限流（按来源 IP）。
# 单独一套是因为它不能复用认证端点的 5 次/5 分钟：进页面取一题、答错点「换一道」、
# 严格模式下挂载重复一次，几步就被正常用户打满；打满后题干一片空白、注册被堵死。
# 共用 RATE_LIMIT_DISABLED 总开关。
# 人机验证本身**不是环境变量**，而是站点设置（后台「注册设置」里改，存 DB）：
#   CAPTCHA_TYPE = none | math | image | external
#   EXTERNAL_CAPTCHA_PRESET / _SITE_KEY / _SECRET / _VERIFY_URL / _SCRIPT_URL / _GLOBAL_NAME
# 老站点只写过 ENABLE_CAPTCHA 时按 true → math、false → none 推导，行为不变。
# CAPTCHA_GENERATE_RATE_LIMIT_MAX=10
# CAPTCHA_GENERATE_RATE_LIMIT_WINDOW_MS=300000

# 站点公开设置缓存 TTL 毫秒数（默认 30000；写设置会主动失效，无需等 TTL）
# SETTINGS_CACHE_TTL_MS=30000

# /uploads 的跨源读取白名单同样**不是环境变量**，而是站点设置（后台「站点设置」里改）：
#   UPLOAD_CORS_ORIGINS = 逗号/换行分隔的来源；留空 = 只放行同源与站点自身来源；* = 全放行
# 它只管「别的站能不能把纹理读进 canvas」，不防热链（<img> 不走 CORS）。

# 管理后台趋势图按哪个时区切「一天」，单位分钟（默认 480 = UTC+8）。
# 时间戳一律以 UTC 存储，但「某天」是给人看的：按 UTC 分桶会把北京时间
# 00:00–08:00 的活动算到前一天，管理员晚上提交的东西第二天早上会显示在前天。
# 生产容器常跑在 UTC，所以这件事不能依赖进程 TZ，必须显式配置。
# 取值范围 -720..840（UTC-12 .. UTC+14）；越界自动裁剪回默认值，不会让服务起不来。
# 注意 0（UTC）与负数都是合法值，不要用「正整数」的直觉去理解它。
# STATS_TZ_OFFSET_MINUTES=480

# 反代层数/可信代理（Express trust proxy）。生产是 OpenResty + 1Panel，
# 不设置时 req.ip 是反代自身地址 → 按 IP 限流的端点（如注册）会把所有用户算成一个桶。
# 仅在确实位于可信反代之后才可开启，否则客户端可伪造 X-Forwarded-For 绕过限流。
# TRUST_PROXY=1

# ---- 仅测试用 ----
# 指向一个【可随意销毁的空临时库】时，smoke test 会额外执行 PostgreSQL 全套迁移测试
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/mcsts_smoke_test

# 指向一个【可随意销毁的】Redis 时，缓存测试会额外执行 Redis 实现用例（未设置则 skip）
# TEST_REDIS_URL=redis://127.0.0.1:63799

# 指向一个【本地 Mailpit / 可销毁的 SMTP】时，邮件链路测试会走真实 SMTP 事务
# （未设置则整块 skip）。INDEV/mailpit/ 起的就是这两个端口，见 INDEV/README.md
# TEST_SMTP_URL=smtp://127.0.0.1:10259

# Mailpit 的 Web API 地址，用于把「对端收到的报文」读回来断言（与上面成对使用）
# TEST_SMTP_API_URL=http://127.0.0.1:18025

